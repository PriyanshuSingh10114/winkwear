# ==========================================
# BackEnd (Node.js + Express) .gitignore
# ==========================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.development
.env.production
.env.test
.env.*
!.env.example
*.pem

# Uploads & Media (Uploaded by users / products)
uploads/
uploads/**
!uploads/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / Transpiled outputs
dist/
build/
out/
.cache/

# Coverage / Testing
coverage/
.nyc_output/

# Editor & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
