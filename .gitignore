# ==========================================
# Root .gitignore for WinkWear Monorepo
# ==========================================

# Dependencies
node_modules/
*/node_modules/
**/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
*.pem

# Production Build Outputs
dist/
dist-ssr/
build/
out/
*/dist/
*/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Uploads & User Generated Content
uploads/
*/uploads/
**/uploads/
!uploads/.gitkeep
!*/uploads/.gitkeep

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# Cache & Temp Files
.cache/
.vite/
.turbo/
.parcel-cache/
.eslintcache
*.tmp
*.temp

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
